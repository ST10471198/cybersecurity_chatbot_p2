<Window x:Class="cybersecurity_chatbot_p2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cybersecurity_chatbot_p2"
        mc:Ignorable="d"
        Title="Ruby - Cybersecurity Assistant" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#EDF2F7"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Background" Value="#38A169"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="25" 
                                BorderThickness="0"
                                Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2F855A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#276749"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Action Button Style -->
        <Style x:Key="QuickActionButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="14" 
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#A0AEC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#38A169"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="CaretBrush" Value="#38A169"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2F855A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#EDF2F7">

        <!-- HOME GRID - Welcome Screen -->
        <Grid 
            x:Name="home_grid" 
            Visibility="Visible" 
            Background="#EDF2F7">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Logo Image -->
            <Image 
                Source="/logo.jpeg" 
                Height="160" 
                Width="240" 
                Grid.Row="1"
                HorizontalAlignment="Center"/>

            <!-- Welcome Title -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock 
                    Text="Welcome to Ruby" 
                    FontFamily="Segoe UI" 
                    FontWeight="Bold" 
                    FontSize="28"
                    Foreground="#22543D"
                    HorizontalAlignment="Center"/>

                <TextBlock 
                    Text="Your Cybersecurity Assistant" 
                    FontFamily="Segoe UI" 
                    FontWeight="SemiBold" 
                    FontSize="15"
                    Foreground="#38A169"
                    HorizontalAlignment="Center"
                    Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Subtitle -->
            <TextBlock 
                Grid.Row="3"
                Text="Learn about online safety, manage tasks, and test your knowledge"
                FontFamily="Segoe UI" 
                FontSize="12" 
                Foreground="#718096"
                HorizontalAlignment="Center"
                Margin="0,10,0,20"/>

            <!-- Continue Button -->
            <Button 
                Grid.Row="3"
                Style="{StaticResource ModernButton}"
                Content="Get Started"
                Click="proceed"
                Margin="0,50,0,0"
                VerticalAlignment="Top"/>

            <!-- Version Info -->
            <TextBlock 
                Grid.Row="4"
                Text="Version 3.0 | Cybersecurity Awareness Chatbot"
                FontFamily="Segoe UI" 
                FontSize="10" 
                Foreground="#A0AEC0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,15"/>

        </Grid>

        <!-- USERNAME GRID - Name Collection Screen -->
        <Grid 
            x:Name="username_grid" 
            Visibility="Hidden" 
            Background="#EDF2F7">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Logo Image -->
            <Image 
                Source="/logo.jpeg" 
                Height="120" 
                Width="180" 
                Grid.Row="1"
                HorizontalAlignment="Center"/>

            <!-- Title -->
            <TextBlock 
                Grid.Row="2"
                Text="Let's get started!" 
                FontFamily="Segoe UI" 
                FontWeight="Bold" 
                FontSize="24"
                Foreground="#22543D"
                HorizontalAlignment="Center"
                Margin="0,10,0,0"/>

            <!-- Subtitle -->
            <TextBlock 
                Grid.Row="3"
                Text="Enter your name to personalize your experience"
                FontFamily="Segoe UI" 
                FontSize="12" 
                Foreground="#718096"
                HorizontalAlignment="Center"
                Margin="0,3,0,15"/>

            <!-- Username TextBox -->
            <TextBox 
                Grid.Row="4"
                Style="{StaticResource ModernTextBox}"
                Height="42" 
                Width="300" 
                TextAlignment="Center" 
                x:Name="usernames_input"
                MaxLength="30"
                HorizontalAlignment="Center"/>

            <!-- Error Message -->
            <TextBlock 
                Grid.Row="5"
                Text="Please enter your name to continue..."
                FontFamily="Segoe UI" 
                FontSize="11" 
                FontWeight="SemiBold"
                Foreground="#FC8181" 
                Visibility="Collapsed" 
                x:Name="errorMessage"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"/>

            <!-- Submit Button -->
            <Button 
                Grid.Row="5"
                Style="{StaticResource ModernButton}"
                Content="Start Chatting"
                Click="submit_name"
                Margin="0,45,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"/>

        </Grid>

        <!-- CHAT GRID - Main Chat Interface -->
        <Grid 
            x:Name="chat_grid" 
            Visibility="Hidden" 
            Background="#EDF2F7">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CHAT HEADER -->
            <Border 
                Grid.Row="0"
                Height="55" 
                Background="#22543D"
                BorderBrush="#276749"
                BorderThickness="0,0,0,2">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bot Icon -->
                    <Border Grid.Column="0" 
                            Width="34" 
                            Height="34" 
                            Background="#E6FFFA" 
                            CornerRadius="17"
                            Margin="15,0,0,0">
                        <TextBlock Text="R" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#22543D"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <TextBlock 
                            Text="Ruby" 
                            FontSize="18" 
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            FontFamily="Segoe UI"/>

                        <TextBlock 
                            Text=" - Cybersecurity Assistant" 
                            FontSize="13" 
                            FontWeight="SemiBold"
                            Foreground="#E6FFFA" 
                            FontFamily="Segoe UI"
                            Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- Status Indicator -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center"
                                Margin="0,0,15,0">
                        <Border 
                            Background="#48BB78" 
                            CornerRadius="8"
                            Height="10"
                            Width="10">
                            <TextBlock 
                                Text=" " 
                                Foreground="Transparent"/>
                        </Border>
                        <TextBlock 
                            Text="Online" 
                            FontSize="10"
                            Foreground="#E6FFFA"
                            FontWeight="SemiBold"
                            Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CHAT MESSAGES LIST -->
            <ListView 
                Grid.Row="1"
                x:Name="chats" 
                Margin="10,10,10,8"
                Background="Transparent" 
                BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- INPUT AREA -->
            <Grid 
                Grid.Row="2" 
                Margin="10,0,10,10"
                Height="95">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Quick Action Buttons -->
                <WrapPanel 
                    Grid.Row="0" 
                    Orientation="Horizontal" 
                    Margin="0,0,0,5">

                    <Button 
                        Content="Tasks" 
                        Style="{StaticResource QuickActionButton}"
                        Background="#38A169" 
                        Foreground="White"
                        Click="quick_action_tasks"/>

                    <Button 
                        Content="Quiz" 
                        Style="{StaticResource QuickActionButton}"
                        Background="#ED8936" 
                        Foreground="White"
                        Margin="4,0,0,0"
                        Click="quick_action_quiz"/>

                    <Button 
                        Content="Log" 
                        Style="{StaticResource QuickActionButton}"
                        Background="#4299E1" 
                        Foreground="White"
                        Margin="4,0,0,0"
                        Click="quick_action_log"/>

                    <Button 
                        Content="Help" 
                        Style="{StaticResource QuickActionButton}"
                        Background="#A0AEC0" 
                        Foreground="White"
                        Margin="4,0,0,0"
                        Click="quick_action_help"/>

                    <Button 
                        Content="Clear" 
                        Style="{StaticResource QuickActionButton}"
                        Background="#FC8181" 
                        Foreground="White"
                        Margin="4,0,0,0"
                        Click="quick_action_clear"/>

                </WrapPanel>

                <!-- Input Row -->
                <Border Grid.Row="1" 
                        Background="White" 
                        CornerRadius="12"
                        BorderBrush="#38A169"
                        BorderThickness="2"
                        Height="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox 
                            x:Name="question" 
                            Grid.Column="0"
                            Height="40" 
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI" 
                            FontSize="13"
                            Background="Transparent" 
                            BorderThickness="0"
                            Foreground="#2D3748" 
                            CaretBrush="#38A169"
                            TextWrapping="Wrap"
                            KeyDown="question_KeyDown"
                            AcceptsReturn="False"
                            Padding="12,0"/>

                        <!-- Placeholder Text -->
                        <TextBlock Text="Type your message..." 
                                   FontFamily="Segoe UI" 
                                   FontSize="13" 
                                   Foreground="#A0AEC0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=question}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=question}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Send Button -->
                        <Button 
                            Grid.Column="1"
                            Height="36" 
                            Width="90" 
                            Margin="8,0,8,0" 
                            Content="Send"
                            Click="send" 
                            Background="#38A169" 
                            Foreground="White"
                            FontWeight="SemiBold" 
                            FontSize="13" 
                            FontFamily="Segoe UI"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8" 
                                            BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2F855A"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#276749"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

            </Grid>

            <!-- INPUT HINT -->
            <TextBlock 
                Grid.Row="2"
                Text="Try: 'Add task', 'Show tasks', 'Start quiz', 'Show activity log'"
                VerticalAlignment="Bottom" 
                Margin="10,0,0,68" 
                FontSize="9"       
                Foreground="#A0AEC0" 
                FontFamily="Segoe UI"
                FontWeight="SemiBold"/>

        </Grid>

    </Grid>
</Window>